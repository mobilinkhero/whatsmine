<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_INSTALLED" value="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests MUST NOT run against the .env database: 79 test files use
             RefreshDatabase, which runs migrate:fresh and would drop every table in
             the developer's (or a buyer's) working install. Point them at a
             dedicated throwaway schema instead.
             First-time setup:  CREATE DATABASE wm3_test;
             sqlite/:memory: is not viable here — the suite relies on MySQL-specific
             migrations, and tests that don't use RefreshDatabase expect a migrated
             database to already exist. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="wm3_test"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="BROADCAST_CONNECTION" value="log"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="VITE_TESTING" value="true"/>
    </php>
</phpunit>
